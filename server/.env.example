PORT=3333
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:5500
# ALLOWED_ORIGINS=http://localhost:5500,https://seudominio.com

# Admin (criado automaticamente no primeiro start)
ADMIN_EMAIL=admin@casasopimenta.com.br
ADMIN_PASSWORD=Alterar_Senha_Forte_Aqui

# JWT (gere um valor forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=Gere_um_valor_aleatorio_forte_com_o_comando_abaixo

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Banco de Dados
SUPABASE_DB_URL=postgresql://postgres:senha@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx
MP_ACCESS_TOKEN_TEST=TEST-xxxx
MP_PUBLIC_KEY_TEST=TEST-xxxx
APP_URL=https://seudominio.com
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://seudominio.com/api/payments/webhook

# Frete e Entregas
ORIGIN_CEP=30190922
BOX_P_MAX_WEIGHT=1
BOX_M_MAX_WEIGHT=5
BOX_P_DIM=24x16x8
BOX_P_PRICE=7.40
BOX_M_DIM=30x22x13
BOX_M_PRICE=8.30
BOX_G_DIM=36x28x28
BOX_G_PRICE=15.35

# Melhor Envio (OAuth 2.0)
# Criar aplicativo em: https://sandbox.melhorenvio.com.br → Integrações → Área Dev
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=http://localhost:3333/api/melhor-envio/callback

# Loja (exibido na retirada)
STORE_ADDRESS=Avenida Augusto de Lima, 744 M4 113, 117 - Centro, Belo Horizonte - MG, 30190-922
STORE_HOURS=Seg a Sab: 08h-18h | Dom: 08h-13h
CONTACT_PHONE=(31) 98314-3902

# Cloudinary (armazenamento de imagens)
# Criar conta gratis: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=SEU_CLOUD_NAME
CLOUDINARY_API_KEY=SUA_API_KEY
CLOUDINARY_API_SECRET=SUA_API_SECRET

# Email (SendGrid para recuperação de senha)
# Criar conta: https://signup.sendgrid.com
# Gerar API Key: Settings → API Keys → Create API Key
SENDGRID_API_KEY=SUA_CHAVE_AQUI
SENDGRID_FROM="Casa Só Pimenta" <casasopimenta@gmail.com>
